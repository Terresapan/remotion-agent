WEB_PORT=3101
WORKER_API_BASE_URL=http://localhost:3201
OPENSHELL_BRIDGE_PYTHON=python3
OPENSHELL_SANDBOX_NAME=remotionagent-sandbox
# Path to the Remotion template inside the container (Docker default: /template/remotion-teaching-template)
REMOTION_TEMPLATE_PATH=/path/to/your/remotion-template
# Leave blank to use the default relative path (<repo-root>/workspaces)
REMOTION_WORKSPACES_ROOT=
# Used by docker-compose for the template volume mount on the host
REMOTION_TEMPLATE_HOST_PATH=/path/to/your/remotion-template
# Used by docker-compose for the OpenShell config volume mount on the host
OPENSHELL_CONFIG_HOST_PATH=~/.config/openshell
WORKSPACE_SYNC_ALLOWLIST_FILE=
AGENT_MEMORY_FILE=
AGENT_SKILLS_ROOTS=
JOB_ASSETS_ROOT=
JOB_ASSET_MAX_FILE_BYTES=26214400
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_TEMPERATURE=0.1
NVIDIA_MAX_TOKENS=4096
